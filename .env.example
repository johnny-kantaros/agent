# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_USER_ID=your_telegram_user_id
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret

# Google Calendar
GOOGLE_APPLICATION_CREDENTIALS_JSON_B64=base64_encoded_credentials
CALENDAR_ID=your_calendar_id

# Tennis Booking
TENNIS_API_KEY=your_api_key
TENNIS_PARTICIPANT_ID=your_participant_id
TENNIS_LOGIN_EMAIL=your_email
TENNIS_LOGIN_PASSWORD=your_password
STRIPE_PAYMENT_METHOD_ID=your_payment_method
STRIPE_PK=your_stripe_public_key

# Squash Booking (Bay Club)
BAYCLUB_USERNAME=your_username
BAYCLUB_PASSWORD=your_password

# Database (optional, defaults to /data/agent.db)
DB_PATH=/data/agent.db
